# load packages
import pandas as pd
import os
from snakemake.utils import validate
from snakemake.utils import min_version

# check snakemake version
min_version("9.3.3")

# configuration
configfile: "../config/config.yaml"


validate(config, "../config/config.schema.yaml")


# container version of workflow
containerized: "docker://milesroberts/poolseq-kmers"


# load samples
parameters = pd.read_table(
    "../config/parameters.tsv", sep="\t", dtype={"ID": str}
).set_index(["ID"], drop=False)
validate(parameters, "../config/parameters.schema.yaml")

# split into paired-end and single-end
one_pop_params = parameters[
    (parameters["simtype"] == "onepop")
]

sweep_params = parameters[
    (parameters["simtype"] == "sweep")
]

two_pop_params = parameters[
    (parameters["simtype"] == "twopop")
]


wildcard_constraints:
    ID="[a-zA-Z0-9]+",
    SID="[a-zA-Z0-9]+",
    PID="[a-zA-Z0-9]+",
    num="[0-9]+",
    read="[a-zA-Z0-9]+",
    #chr="[a-zA-Z0-9]+"

localrules: all_per_sim

#
# create histograms across reference genomes
# input function for the rule aggregate
def aggregate_histos(wildcards):
    checkpoint_output = checkpoints.datasets_rehydrate.get(**wildcards).output[0]
    print(checkpoint_output)
    return expand("kmc_histo_results/{species}_{k}.histo", species = glob_wildcards(os.path.join(checkpoint_output, "{i}.fna")).i, k = config["k_zeta"])

def aggregate_stats(wildcards):
    checkpoint_output = checkpoints.datasets_rehydrate.get(**wildcards).output[0]
    print(checkpoint_output)
    return expand("seqkit_stats_results/{species}.txt", species = glob_wildcards(os.path.join(checkpoint_output, "{i}.fna")).i)

#
rule all:
    input:
        "calls.txt",
        aggregate_histos,
        aggregate_stats,
        #expand("kmc_histo_results/{species}_{k}.histo", species = config["species"], k = config["k_zeta"]),
        expand("finished/{SID}_0.done", SID=one_pop_params.index.get_level_values("ID")),
        expand("finished/{SID}_0.done", SID=sweep_params.index.get_level_values("ID")),
        expand("finished/{SID}_{PID}.done", SID=two_pop_params.index.get_level_values("ID"), PID=[0,1]),
        "multiqc_report.html"
        #expand("calls_{chr}.vcf", chr = ["A01", "A02", "A03", "A04", "A05", "A06", "A07", "A08", "A09", "A10"])

# rule to apply freqk and vg giraffe to real data 
rule all_empirical:
    input:
        expand("real_freqk_results/{num}/calls.txt", num = config["num_reads"]),
        expand("real_bcftools_call_results/{num}_{chr}.vcf", chr = config["chroms"], num = config["num_reads"]),
        expand("real_freebayes_results/{num}_{chr}.vcf", chr = config["chroms"], num = config["num_reads"]),
        expand("real_varscan_results/{num}_{chr}.tsv", chr = config["chroms"], num = config["num_reads"]),
        expand("{chr}_{num}_real_poolsnp_results.vcf.gz", chr = config["chroms"], num = config["num_reads"])
        #"real.vcf"

# create histograms across reference genomes
rule all_histos:
    input:
        aggregate_histos,
        aggregate_stats
        #expand("kmc_histo_results/{species}_{k}.histo", species = config["species"], k = config["k_zeta"])

# perform simulations
# additional rule helps with batching
rule all_sims:
    input:
        expand("finished/{SID}_0.done", SID=one_pop_params.index.get_level_values("ID")),
        expand("finished/{SID}_0.done", SID=sweep_params.index.get_level_values("ID")),
        expand("finished/{SID}_{PID}.done", SID=two_pop_params.index.get_level_values("ID"), PID=[0,1]),
        "multiqc_report.html"

rule all_neutral_sims:
    input:
        expand("finished/{SID}_0.done", SID=one_pop_params.index.get_level_values("ID")),

rule all_sweep_sims:
    input:
        expand("finished/{SID}_0.done", SID=sweep_params.index.get_level_values("ID")),

rule all_two_sims:
    input:
        expand("finished/{SID}_{PID}.done", SID=two_pop_params.index.get_level_values("ID"), PID=[0,1]),

