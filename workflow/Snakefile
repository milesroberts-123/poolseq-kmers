# load packages
import pandas as pd
import os
from snakemake.utils import validate
#from snakemake.utils import Paramspace
from snakemake.utils import min_version

min_version("9.3.3")

# configuration
configfile: "../config/config.yaml"


validate(config, "../config/config.schema.yaml")


# container version of workflow
containerized: "docker://milesroberts/poolseq-kmers"


# load samples
parameters = pd.read_table(
    "../config/parameters.tsv", sep="\t", dtype={"ID": str}
).set_index(["ID"], drop=False)
validate(parameters, "../config/parameters.schema.yaml")


# declare a dataframe to be a paramspace
#parameters = Paramspace(parameters)


# split into paired-end and single-end
one_pop_params = parameters[
    (parameters["simtype"] == "onepop") | (parameters["simtype"] == "sweep")
]

two_pop_params = parameters[
    (parameters["simtype"] == "twopop") | (parameters["simtype"] == "bsa")
]


wildcard_constraints:
    ID="\\d+",
    SID="[a-zA-Z0-9]+",
    PID="[a-zA-Z0-9]+"

localrules: all_per_sim

# rule report:
#    input:
#        expand("{ID}.done", ID=one_pop_params.index.get_level_values("ID")),
# 	expand("{ID}_p1p2.done", ID=two_pop_params.index.get_level_values("ID")),
#    output:
#        "report.html"
#    params:
#        wd = get_wd
#    conda:
#        "../envs/r_markdown.yaml"
#    log:
#        "logs/r_markdown.log"
#    shell:
#        """
#        Rscript -e 'parameters <- list(root_directory = "{params.wd}");
#                    rmarkdown::render("notebooks/kmer_poolseq_maf_prediction.Rmd",
#                                      params      = parameters,
#                                      output_dir  = "{params.wd}",
#                                      output_file = "{output}")'
#        """

rule all_histos:
    input:
        expand("kmc_histo_results/{species}.histo", species = config["species"])

rule all_sims:
    input:
        expand("finished/{SID}_0.done", SID=one_pop_params.index.get_level_values("ID")),
        expand("finished/{SID}_{PID}.done", SID=two_pop_params.index.get_level_values("ID"), PID=[0,1]),
        "multiqc_report.html"

rule all_per_sim:
    input:
        "varscan_results/{SID}_{PID}.tsv",
        "smudgeplot_results/{SID}_{PID}_coverages.tsv",
        "disco_results/{SID}_{PID}.txt",
        "slim_results/allele_freqs_{SID}_{PID}.txt",
        "poolsnp_results/{SID}_{PID}.txt",
        "freebayes_de_novo_results/{SID}_{PID}.txt",
        "freebayes_a_priori_results/{SID}_{PID}.txt",
        "freebayes_vg_results/{SID}_{PID}.txt",
        "blast_results/{SID}_{PID}.txt",
        "hetmers_results/{SID}_{PID}_counts.csv",
        "seqkit_results/center_kmer_pairs_{SID}.txt",   
        "freqk_results/{SID}_{PID}_counts.txt"    
    #"dissimilarity_results/{SID}.txt"
    output:
        touch("finished/{SID}_{PID}.done")

